# 蜀道智能安全助手 — 后端环境变量模板
# 复制为 .env 并填写真实值（.env 已被 .gitignore 排除，禁止提交）

# ---- 应用 ----
DEBUG=true

# ---- 安全（必须修改！）----
SECRET_KEY=please-generate-a-random-secret
# 生成方式: python -c "import secrets; print(secrets.token_hex(32))"

# ---- 数据层 ----
DATABASE_URL=mysql+mysqlconnector://root:123456@127.0.0.1:3306/shudao_safety?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/0

# ---- AI（P2 线填写，D1 可留空）----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-2.5-flash
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=qwen3.8max

# ---- 文件存储 / CORS ----
UPLOAD_DIR=uploads
CORS_ORIGINS=*
